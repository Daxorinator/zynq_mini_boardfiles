# U-Boot environment in the QSPI flash (CONFIG_ENV_OFFSET 0xE00000 and redundant copy at 0xE40000, 128 KiB each), seen through the "qspi-kernel" MTD partition that starts at 0x500000
# device     offset   env size   sector size
/dev/mtd1    0x900000 0x20000    0x10000
/dev/mtd1    0x940000 0x20000    0x10000
