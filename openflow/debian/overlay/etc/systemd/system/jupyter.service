[Unit]
Description=Jupyter Notebook (zynqmini notebooks, runs as root for /dev/mem and FPGA access)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/home/zynq/notebooks
ExecStart=/usr/bin/jupyter-notebook --allow-root --no-browser --ip=0.0.0.0 --port=9090 --notebook-dir=/home/zynq/notebooks
Restart=on-failure
Nice=-5
[Install]
WantedBy=multi-user.target
