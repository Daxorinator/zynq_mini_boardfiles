[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 150
cover: mode cover
cover: depth 150
multiclock on

[engines]
smtbmc boolector

[script]
read_verilog -formal -sv formal_ps7_gp0.v
read_verilog -formal ple_mac_f.v
read_verilog -formal -sv formal_ple_mac.v
read_verilog -formal models_formal_bufg.v
read_verilog -formal models_formal_mmcm.v
read_verilog -formal models_formal_ple.v
prep -flatten -top formal_ple_mac
splitnets
opt_clean

[files]
ple_mac_props.vh
formal_ps7_gp0.v
ple_mac_f.v
formal_ple_mac.v
../sim/models_formal_bufg.v
models_formal_mmcm.v
models_formal_ple.v
