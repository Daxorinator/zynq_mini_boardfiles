// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * ZYNQ MINI (Bochen Jingxin, XC7Z010-1CLG400, 512 MB DDR3): Linux device tree, hand-written from the board specification
 * (docs/) on top of the kernel's zynq-7000.dtsi. No Vivado/PetaLinux-generated input.
 */
/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "ZYNQ MINI";
	compatible = "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		spi0 = &qspi;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
	};

	chosen {
		bootargs = "root=/dev/mmcblk0p2 rw rootfstype=ext4 rootwait earlycon devtmpfs.mount=1 clk_ignore_unused uio_pdrv_genirq.of_id=generic-uio";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;                 /* 512 MB */
	};

	/* ULPI USB PHY (USB3320) behind the PS USB0 controller */
	usb_phy0: phy0 {
		compatible = "ulpi-phy";
		#phy-cells = <0>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x170>;
		drv-vbus;
	};

	/* IRQ_F2P[0] (GIC SPI 61) and the GP0 window, exposed to user space as /dev/uioN named "fabric" */
	fabric@40000000 {
		compatible = "generic-uio";
		reg = <0x40000000 0x10000>;
		interrupt-parent = <&intc>;
		interrupts = <0 29 4>;
	};
};

&clkc {
	ps-clk-frequency = <33333333>;              /* 33.333 MHz PS crystal */
	fclk-enable = <0x0>;
};

&cpu0 {
	operating-points = <666666 1000000 333333 1000000>;
};

&gpio0 {
	emio-gpio-width = <64>;
	gpio-mask-high = <0x0>;
	gpio-mask-low = <0x5600>;
};

&gem0 {                                          /* PS Ethernet: RTL8211E on MIO16-27, RGMII with PHY-side delays */
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy0>;
	xlnx,ptp-enet-clock = <0x69f6bcb>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy0: ethernet-phy@0 {
			reg = <0>;
			device_type = "ethernet-phy";
		};
	};
};

&qspi {                                          /* W25Q128 (16 MB) */
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
	spi-rx-bus-width = <4>;
	spi-tx-bus-width = <4>;
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@0 { label = "qspi-boot";    reg = <0x000000 0x500000>; };
		partition@1 { label = "qspi-kernel";  reg = <0x500000 0xa80000>; };
		partition@2 { label = "qspi-bootenv"; reg = <0xf80000 0x020000>; };
	};
};

&sdhci0 {                                        /* SD0 (boot card) */
	status = "okay";
	xlnx,has-cd = <0>;
	xlnx,has-power = <0>;
	xlnx,has-wp = <0>;
};

&sdhci1 {                                        /* SD1, hot-pluggable: no card-detect line routed */
	status = "okay";
	xlnx,has-cd = <0>;
	xlnx,has-power = <0>;
	xlnx,has-wp = <0>;
	broken-cd;
};

&uart1 {                                         /* console on MIO48/49 */
	status = "okay";
	cts-override;
	device_type = "serial";
	port-number = <0>;
};

&usb0 {                                          /* PS USB: host/device switching via the role switch */
	status = "okay";
	phy_type = "ulpi";
	usb-phy = <&usb_phy0>;
	usb-reset = <&gpio0 46 0>;
	dr_mode = "otg";
	usb-role-switch;
};
