// ZYNQ MINI (XC7Z010, 512 MB DDR3) U-Boot device tree, derived from the PetaLinux-generated system-top.dts
/dts-v1/;
#include "zynq-7000.dtsi"
#include "zynq-zynqmini-pcw.dtsi"
/ {
	model = "ZYNQ MINI";
	compatible = "xlnx,zynq-7000";
	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0:115200n8";
	};
	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		spi0 = &qspi;
		mmc0 = &sdhci0;
	};
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};
};

/* nodes the SPL needs (existing Zynq boards mark the same ones bootph-all) */
&uart1 {
	bootph-all;
	status = "okay";
};

&sdhci0 {
	bootph-all;
	status = "okay";
};

&qspi {
	bootph-all;
	/* W25Q128FV, 16 MiB: the SPL reads u-boot.img from it when the boot switch selects QSPI */
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		bootph-all;
	};
};

&gem0 {
	phy-handle = <&ethernet_phy>;
	ethernet_phy: ethernet-phy@0 {
		reg = <0>;
	};
};
